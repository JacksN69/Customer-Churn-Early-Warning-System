            "attributeHierarchy": {
              "state": "ready"
            }
          },
          {
            "type": "calculated",
            "name": "IsEligibleWindow",
            "dataType": "int64",
            "expression": "IF ( DimDate[YearMonthSort] >= 202306 && DimDate[YearMonthSort] <= 202311, 1, 0 )",
            "summarizeBy": "none",
            "state": "calculationNeeded",
            "attributeHierarchy": {}
          },
          {
            "type": "calculated",
            "name": "EligibleMonthFlag",
            "dataType": "string",
            "expression": "IF ( DimDate[YearMonthSort] >= 202306 && DimDate[YearMonthSort] <= 202311, \"Ja\", \"Nein\" )",
            "summarizeBy": "none",
            "state": "calculationNeeded",
            "attributeHierarchy": {}
          },
          {
            "type": "calculated",
            "name": "PipelinePhase",
            "dataType": "string",
            "expression": "SWITCH ( TRUE(), DimDate[YearMonthSort] <= 202305, \"1. Historie-Aufbau (Jan-Mai)\", DimDate[YearMonthSort] <= 202309, \"2. Training (Jun-Sep)\", DimDate[YearMonthSort] = 202310, \"3. Validierung (Okt)\", DimDate[YearMonthSort] = 202311, \"4. Test Out-of-Sample (Nov)\", \"5. Produktion Scoring (Dez -> Jan)\" )",
            "sortByColumn": "PipelinePhaseSort",
            "summarizeBy": "none",
            "state": "calculationNeeded",
            "attributeHierarchy": {}
          },
          {
            "type": "calculated",
            "name": "PipelinePhaseSort",
            "dataType": "int64",
            "expression": "SWITCH ( TRUE(), DimDate[YearMonthSort] <= 202305, 1, DimDate[YearMonthSort] <= 202309, 2, DimDate[YearMonthSort] = 202310, 3, DimDate[YearMonthSort] = 202311, 4, 5 )",
            "summarizeBy": "none",
            "state": "calculationNeeded",
            "attributeHierarchy": {}
          }
        ],
        "partitions": [
          {
            "name": "DimDate",
            "state": "ready",
            "source": {
              "type": "calculated",
              "expression": "VAR FirstMonth = DATE ( YEAR ( MIN ( ChurnFeatures[Month] ) ), MONTH ( MIN ( ChurnFeatures[Month] ) ), 1 )\nVAR MonthSpan = DATEDIFF ( FirstMonth, MAX ( ChurnFeatures[Month] ), MONTH )\nRETURN\n    ADDCOLUMNS (\n        SELECTCOLUMNS ( GENERATESERIES ( 0, MonthSpan ), \"Date\", EDATE ( FirstMonth, [Value] ) ),\n        \"Year\", YEAR ( [Date] ),\n        \"MonthNumber\", MONTH ( [Date] ),\n        \"MonthName\", FORMAT ( [Date], \"mmmm\" ),\n        \"YearMonth\", FORMAT ( [Date], \"yyyy-MM\" ),\n        \"YearMonthSort\", YEAR ( [Date] ) * 100 + MONTH ( [Date] ),\n        \"Quarter\", \"Q\" & ROUNDUP ( MONTH ( [Date] ) / 3, 0 )\n    )"
            }
          }
        ]
      },
