        "partitions": [
          {
            "name": "ChurnPredictions",
            "mode": "import",
            "state": "ready",
            "source": {
              "type": "m",
              "expression": "let\n    Source = Parquet.Document(File.Contents(\"C:\\Users\\user\\Customer Churn Early-Warning System\\outputs\\churn_predictions.parquet\"))\nin\n    Source"
            }
          }
        ],
        "measures": [
          {
            "name": "Bewertete aktive Kunden",
            "expression": "DISTINCTCOUNT ( ChurnPredictions[customer_id] )",
            "formatString": "#,0",
            "displayFolder": "01 Management & Frühwarnsystem",
            "dataType": "int64"
          },
          {
            "name": "Bewertete aktive Kunden (Dez 2023)",
            "expression": "CALCULATE ( DISTINCTCOUNT ( ChurnPredictions[customer_id] ), ChurnPredictions[ScoreType] = \"Production (Dec 2023 -> Jan 2024)\" )",
            "formatString": "#,0",
            "displayFolder": "01 Management & Frühwarnsystem",
            "dataType": "int64"
          },
          {
            "name": "Kunden mit hohem/kritischem Risiko",
            "expression": "CALCULATE ( DISTINCTCOUNT ( ChurnPredictions[customer_id] ), ChurnPredictions[RiskLevel] IN { \"Critical\", \"High\" } )",
            "formatString": "#,0",
            "displayFolder": "01 Management & Frühwarnsystem",
            "dataType": "int64"
          },
          {
            "name": "Anteil Hoch-/Kritisch-Risiko",
            "expression": "DIVIDE ( [Kunden mit hohem/kritischem Risiko], [Bewertete aktive Kunden] )",
            "formatString": "0.00 %",
            "displayFolder": "01 Management & Frühwarnsystem",
            "dataType": "double"
          },
          {
            "name": "Kunden Top-10% Risiko-Rang",
            "expression": "CALCULATE ( DISTINCTCOUNT ( ChurnPredictions[customer_id] ), ChurnPredictions[IsTop10PctRank] = 1 )",
            "formatString": "#,0",
            "displayFolder": "01 Management & Frühwarnsystem",
            "dataType": "int64"
          },
          {
            "name": "Werthaltige Risikokunden",
            "expression": "CALCULATE ( DISTINCTCOUNT ( ChurnPredictions[customer_id] ), ChurnPredictions[PriorityQuadrant] = \"High value + High risk\" )",
            "formatString": "#,0",
            "displayFolder": "01 Management & Frühwarnsystem",
            "dataType": "int64"
          },
          {
            "name": "Durchschnittliches Inaktivitätsrisiko",
            "expression": "AVERAGE ( ChurnPredictions[InactiveProbability] )",
            "formatString": "0.00 %",
            "displayFolder": "01 Management & Frühwarnsystem",
            "dataType": "double"
          },
          {
            "name": "Transaktionsvolumen 3M Hochrisiko (COP)",
            "expression": "CALCULATE ( SUM ( ChurnPredictions[TotalAmount_Recent3M] ), ChurnPredictions[RiskLevel] IN { \"Critical\", \"High\" } )",
            "formatString": "\"COP\" #,0",
            "displayFolder": "01 Management & Frühwarnsystem",
            "dataType": "double"
          },
          {
            "name": "Transaktionsvolumen 3M Gefiltert (COP)",
            "expression": "SUM ( ChurnPredictions[TotalAmount_Recent3M] )",
            "formatString": "\"COP\" #,0",
            "displayFolder": "01 Management & Frühwarnsystem",
            "dataType": "double"
          },
          {
            "name": "Anteil Risikostufe",
            "expression": "DIVIDE ( [Bewertete aktive Kunden], CALCULATE ( [Bewertete aktive Kunden], ALLSELECTED ( ChurnPredictions[RiskLevel], ChurnPredictions[RiskLevelSort] ) ) )",
            "formatString": "0.0 %",
            "displayFolder": "01 Management & Frühwarnsystem",
            "dataType": "double"
          },
          {
            "name": "Durchschnittlicher Priority Score",
            "expression": "AVERAGE ( ChurnPredictions[PriorityScore] )",
            "formatString": "#,0",
            "displayFolder": "01 Management & Frühwarnsystem",
            "dataType": "double"
          },
          {
            "name": "Kunden-ID Auswahl",
            "expression": "SELECTEDVALUE ( DimCustomer[customer_id], \"Bitte Kunden auf Seite 2 auswählen\" )",
            "displayFolder": "03 Kundenprofil 360°",
            "dataType": "string"
          },
          {
            "name": "Kunden Inaktivitätsrisiko (Dez 2023)",
            "expression": "CALCULATE ( MAX ( ChurnPredictions[InactiveProbability] ), ChurnPredictions[ScoreType] = \"Production (Dec 2023 -> Jan 2024)\" )",
            "formatString": "0.00 %",
            "displayFolder": "03 Kundenprofil 360°",
            "dataType": "double"
          },
          {
            "name": "Kunden Risiko-Rang (Dez 2023)",
            "expression": "CALCULATE ( MAX ( ChurnPredictions[RiskRank] ), ChurnPredictions[ScoreType] = \"Production (Dec 2023 -> Jan 2024)\" )",
            "formatString": "#,0",
            "displayFolder": "03 Kundenprofil 360°",
            "dataType": "int64"
          },
          {
            "name": "Kunden Risikostufe (Dez 2023)",
            "expression": "CALCULATE ( SELECTEDVALUE ( ChurnPredictions[RiskLevel], \"-\" ), ChurnPredictions[ScoreType] = \"Production (Dec 2023 -> Jan 2024)\" )",
            "displayFolder": "03 Kundenprofil 360°",
            "dataType": "string"
          },
          {
            "name": "Kunden Prioritätsquadrant (Dez 2023)",
            "expression": "CALCULATE ( SELECTEDVALUE ( ChurnPredictions[PriorityQuadrant], \"-\" ), ChurnPredictions[ScoreType] = \"Production (Dec 2023 -> Jan 2024)\" )",
            "displayFolder": "03 Kundenprofil 360°",
            "dataType": "string"
          },
          {
            "name": "Kunden Tage seit letzter Transaktion (Dez 2023)",
            "expression": "CALCULATE ( MAX ( ChurnPredictions[DaysSinceLastTransaction] ), ChurnPredictions[ScoreType] = \"Production (Dec 2023 -> Jan 2024)\" )",
            "formatString": "#,0",
            "displayFolder": "03 Kundenprofil 360°",
            "dataType": "double"
          },
          {
            "name": "SHAP Treiber Name",
            "expression": "VAR Slot = SELECTEDVALUE ( DriverRankSlot[SlotNumber] ) RETURN CALCULATE ( SWITCH ( Slot, 1, SELECTEDVALUE ( ChurnPredictions[TopDriver1] ), 2, SELECTEDVALUE ( ChurnPredictions[TopDriver2] ), 3, SELECTEDVALUE ( ChurnPredictions[TopDriver3] ) ), ChurnPredictions[ScoreType] = \"Production (Dec 2023 -> Jan 2024)\" )",
            "displayFolder": "03 Kundenprofil 360°",
            "dataType": "string"
          },
          {
            "name": "SHAP Treiber Wert",
            "expression": "VAR Slot = SELECTEDVALUE ( DriverRankSlot[SlotNumber] ) RETURN CALCULATE ( SWITCH ( Slot, 1, MAX ( ChurnPredictions[TopDriver1Value] ), 2, MAX ( ChurnPredictions[TopDriver2Value] ), 3, MAX ( ChurnPredictions[TopDriver3Value] ) ), ChurnPredictions[ScoreType] = \"Production (Dec 2023 -> Jan 2024)\" )",
            "formatString": "0.00",
            "displayFolder": "03 Kundenprofil 360°",
            "dataType": "double"
          },
          {
            "name": "SHAP Treiber Einfluss (Log-Odds)",
            "expression": "VAR Slot = SELECTEDVALUE ( DriverRankSlot[SlotNumber] ) RETURN CALCULATE ( SWITCH ( Slot, 1, MAX ( ChurnPredictions[TopDriver1Impact] ), 2, MAX ( ChurnPredictions[TopDriver2Impact] ), 3, MAX ( ChurnPredictions[TopDriver3Impact] ) ), ChurnPredictions[ScoreType] = \"Production (Dec 2023 -> Jan 2024)\" )",
            "formatString": "+0.000;-0.000;0.000",
            "displayFolder": "03 Kundenprofil 360°",
            "dataType": "double"
          },
          {
            "name": "SHAP Treiber Bezeichnung",
            "expression": "VAR Slot = SELECTEDVALUE ( DriverRankSlot[SlotNumber] ) VAR Feat = [SHAP Treiber Name] VAR Val = [SHAP Treiber Wert] RETURN IF ( NOT ISBLANK ( Feat ), Slot & \". \" & Feat & \" (\" & FORMAT ( Val, \"0.##\" ) & \")\", BLANK() )",
            "displayFolder": "03 Kundenprofil 360°",
            "dataType": "string"
          },
          {
            "name": "Anteil Zahlungen (Payment %)",
            "expression": "DIVIDE ( SUM ( ChurnPredictions[PaymentCount] ), SUM ( ChurnPredictions[TransactionCount] ) )",
            "formatString": "0.0 %",
            "displayFolder": "04 Transaktionsmix nach Risiko",
            "dataType": "double"
          },
          {
            "name": "Anteil Überweisungen (Transfer %)",
            "expression": "DIVIDE ( SUM ( ChurnPredictions[TransferCount] ), SUM ( ChurnPredictions[TransactionCount] ) )",
            "formatString": "0.0 %",
            "displayFolder": "04 Transaktionsmix nach Risiko",
            "dataType": "double"
          },
          {
            "name": "Anteil Abhebungen (Withdrawal %)",
            "expression": "DIVIDE ( SUM ( ChurnPredictions[WithdrawalCount] ), SUM ( ChurnPredictions[TransactionCount] ) )",
            "formatString": "0.0 %",
            "displayFolder": "04 Transaktionsmix nach Risiko",
            "dataType": "double"
          },
          {
            "name": "Anteil Einzahlungen (Deposit %)",
            "expression": "DIVIDE ( SUM ( ChurnPredictions[DepositCount] ), SUM ( ChurnPredictions[TransactionCount] ) )",
            "formatString": "0.0 %",
            "displayFolder": "04 Transaktionsmix nach Risiko",
            "dataType": "double"
          },
          {
            "name": "Test ROC-AUC",
            "expression": "0.7405",
            "formatString": "0.0000",
            "displayFolder": "05 Modellgüte (Nov 2023 Test)",
            "dataType": "double"
          },
          {
            "name": "Test PR-AUC",
            "expression": "0.3241",
            "formatString": "0.0000",
            "displayFolder": "05 Modellgüte (Nov 2023 Test)",
            "dataType": "double"
          },
          {
            "name": "Test PR-AUC Baseline (Prävalenz)",
            "expression": "0.1886",
            "formatString": "0.0000",
            "displayFolder": "05 Modellgüte (Nov 2023 Test)",
            "dataType": "double"
          },
          {
            "name": "Test Precision @ Top 10 %",
            "expression": "0.3369",
            "formatString": "0.0 %",
            "displayFolder": "05 Modellgüte (Nov 2023 Test)",
            "dataType": "double"
          },
          {
            "name": "Test Recall @ Top 10 %",
            "expression": "0.1786",
            "formatString": "0.0 %",
            "displayFolder": "05 Modellgüte (Nov 2023 Test)",
            "dataType": "double"
          },
          {
            "name": "Test Lift @ Top 10 %",
            "expression": "1.79",
            "formatString": "0.00\"x\"",
            "displayFolder": "05 Modellgüte (Nov 2023 Test)",
            "dataType": "double"
          },
          {
            "name": "Test Brier Score",
            "expression": "0.1384",
            "formatString": "0.0000",
            "displayFolder": "05 Modellgüte (Nov 2023 Test)",
            "dataType": "double"
          },
          {
            "name": "Test ECE (Kalibrierungsfehler)",
            "expression": "0.0152",
            "formatString": "0.0000",
            "displayFolder": "05 Modellgüte (Nov 2023 Test)",
            "dataType": "double"
          },
          {
            "name": "Test Beobachtete Inaktivitätsquote",
            "expression": "CALCULATE ( AVERAGE ( ChurnPredictions[ActualInactiveNextMonth] ), ChurnPredictions[ScoreType] = \"Test (out-of-sample)\" )",
            "formatString": "0.0 %",
            "displayFolder": "05 Modellgüte (Nov 2023 Test)",
            "dataType": "double"
          }
        ]
      },
