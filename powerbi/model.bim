            "name": "RiskDecile",
            "dataType": "int64",
            "isNameInferred": true,
            "isDataTypeInferred": true,
            "sourceColumn": "ChurnPredictions[RiskDecile]",
            "columnOriginTable": "ChurnPredictions",
            "columnOriginColumn": "RiskDecile",
            "attributeHierarchy": {
              "state": "ready"
            }
          },
          {
            "type": "calculatedTableColumn",
            "name": "Customers",
            "dataType": "int64",
            "isNameInferred": true,
            "isDataTypeInferred": true,
            "sourceColumn": "[Customers]",
            "attributeHierarchy": {
              "state": "ready"
            }
          },
          {
            "type": "calculatedTableColumn",
            "name": "MeanPredicted",
            "dataType": "double",
            "isNameInferred": true,
            "isDataTypeInferred": true,
            "sourceColumn": "[MeanPredicted]",
            "attributeHierarchy": {
              "state": "ready"
            }
          },
          {
            "type": "calculatedTableColumn",
            "name": "ObservedRate",
            "dataType": "double",
            "isNameInferred": true,
            "isDataTypeInferred": true,
            "sourceColumn": "[ObservedRate]",
            "attributeHierarchy": {
              "state": "ready"
            }
          },
          {
            "type": "calculatedTableColumn",
            "name": "DecileLabel",
            "dataType": "string",
            "isNameInferred": true,
            "isDataTypeInferred": true,
            "sourceColumn": "[DecileLabel]",
            "attributeHierarchy": {
              "state": "ready"
            }
          }
        ],
        "partitions": [
          {
            "name": "CalibrationDeciles",
            "state": "ready",
            "source": {
              "type": "calculated",
              "expression": "SUMMARIZECOLUMNS (\n    ChurnPredictions[RiskDecile],\n    FILTER ( ALL ( ChurnPredictions ), ChurnPredictions[ScoreType] = \"Test (out-of-sample)\" ),\n    \"Customers\", COUNTROWS ( ChurnPredictions ),\n    \"MeanPredicted\", AVERAGE ( ChurnPredictions[InactiveProbability] ),\n    \"ObservedRate\", AVERAGE ( ChurnPredictions[ActualInactiveNextMonth] ),\n    \"DecileLabel\", \"Dezil \" & FORMAT ( MIN ( ChurnPredictions[RiskDecile] ), \"00\" )\n)"
            }
          }
        ],
        "measures": [
          {
            "name": "Kalibrierung Prognostiziertes Risiko",
            "expression": "AVERAGE ( CalibrationDeciles[MeanPredicted] )",
            "formatString": "0.0 %",
            "displayFolder": "05 Modellgüte (Nov 2023 Test)",
            "dataType": "double"
          },
          {
            "name": "Kalibrierung Beobachtete Inaktivität",
            "expression": "AVERAGE ( CalibrationDeciles[ObservedRate] )",
            "formatString": "0.0 %",
            "displayFolder": "05 Modellgüte (Nov 2023 Test)",
            "dataType": "double"
          },
          {
            "name": "Kalibrierung Ideallinie (45°)",
            "expression": "AVERAGE ( CalibrationDeciles[MeanPredicted] )",
            "formatString": "0.0 %",
            "displayFolder": "05 Modellgüte (Nov 2023 Test)",
            "dataType": "double"
          }
        ]
      },
