          },
          {
            "type": "calculated",
            "name": "EligibleRowFlag",
            "dataType": "string",
            "expression": "IF ( ChurnFeatures[EligibleForTraining] = 1, \"Ja\", \"Nein\" )",
            "summarizeBy": "none",
            "state": "calculationNeeded",
            "attributeHierarchy": {}
          },
          {
            "type": "calculated",
            "name": "AvgTransactionCount_3M",
            "dataType": "double",
            "expression": "DIVIDE ( ChurnFeatures[TransactionCount_Recent3M], 3.0 )",
            "summarizeBy": "none",
            "state": "calculationNeeded",
            "attributeHierarchy": {}
          },
          {
            "type": "calculated",
            "name": "AvgTransactionCount_6M",
            "dataType": "double",
            "expression": "IF ( ChurnFeatures[Has6MonthHistory] = 1, DIVIDE ( ChurnFeatures[TransactionCount_Recent3M] + ChurnFeatures[TransactionCount_Previous3M], 6.0 ), BLANK() )",
            "summarizeBy": "none",
            "state": "calculationNeeded",
            "attributeHierarchy": {}
          },
          {
            "type": "calculated",
            "name": "RecencyBin",
            "dataType": "string",
            "expression": "SWITCH ( TRUE(), ChurnFeatures[EligibleForTraining] <> 1 || ISBLANK ( ChurnFeatures[DaysSinceLastTransaction] ), BLANK(), ChurnFeatures[DaysSinceLastTransaction] = 0, \"0 Tage (Monatsende)\", ChurnFeatures[DaysSinceLastTransaction] <= 3, \"1-3 Tage\", ChurnFeatures[DaysSinceLastTransaction] <= 7, \"4-7 Tage\", ChurnFeatures[DaysSinceLastTransaction] <= 14, \"8-14 Tage\", ChurnFeatures[DaysSinceLastTransaction] <= 21, \"15-21 Tage\", \"22-31 Tage\" )",
            "sortByColumn": "RecencyBinSort",
            "summarizeBy": "none",
            "state": "calculationNeeded",
            "attributeHierarchy": {}
          },
          {
            "type": "calculated",
            "name": "RecencyBinSort",
            "dataType": "int64",
            "expression": "SWITCH ( TRUE(), ChurnFeatures[EligibleForTraining] <> 1 || ISBLANK ( ChurnFeatures[DaysSinceLastTransaction] ), 99, ChurnFeatures[DaysSinceLastTransaction] = 0, 1, ChurnFeatures[DaysSinceLastTransaction] <= 3, 2, ChurnFeatures[DaysSinceLastTransaction] <= 7, 3, ChurnFeatures[DaysSinceLastTransaction] <= 14, 4, ChurnFeatures[DaysSinceLastTransaction] <= 21, 5, 6 )",
            "summarizeBy": "none",
            "state": "calculationNeeded",
            "attributeHierarchy": {}
          },
          {
            "type": "calculated",
            "name": "ActivityBin",
            "dataType": "string",
            "expression": "SWITCH ( TRUE(), ChurnFeatures[EligibleForTraining] <> 1 || ISBLANK ( ChurnFeatures[AvgTransactionCount_6M] ), BLANK(), ChurnFeatures[AvgTransactionCount_6M] <= 1.5, \"<= 1,5 Trans./Mon.\", ChurnFeatures[AvgTransactionCount_6M] <= 3.0, \"1,6-3,0 Trans./Mon.\", ChurnFeatures[AvgTransactionCount_6M] <= 6.0, \"3,1-6,0 Trans./Mon.\", ChurnFeatures[AvgTransactionCount_6M] <= 10.0, \"6,1-10,0 Trans./Mon.\", \"> 10,0 Trans./Mon.\" )",
            "sortByColumn": "ActivityBinSort",
            "summarizeBy": "none",
            "state": "calculationNeeded",
            "attributeHierarchy": {}
          },
          {
            "type": "calculated",
            "name": "ActivityBinSort",
            "dataType": "int64",
            "expression": "SWITCH ( TRUE(), ChurnFeatures[EligibleForTraining] <> 1 || ISBLANK ( ChurnFeatures[AvgTransactionCount_6M] ), 99, ChurnFeatures[AvgTransactionCount_6M] <= 1.5, 1, ChurnFeatures[AvgTransactionCount_6M] <= 3.0, 2, ChurnFeatures[AvgTransactionCount_6M] <= 6.0, 3, ChurnFeatures[AvgTransactionCount_6M] <= 10.0, 4, 5 )",
            "summarizeBy": "none",
            "state": "calculationNeeded",
            "attributeHierarchy": {}
          }
        ],
        "partitions": [
          {
            "name": "ChurnFeatures",
            "mode": "import",
            "state": "ready",
            "source": {
              "type": "m",
              "expression": "let\n    Source = Parquet.Document(File.Contents(\"C:\\Users\\user\\Customer Churn Early-Warning System\\data\\processed\\churn_features.parquet\"))\nin\n    Source"
            }
          }
        ],
        "measures": [
          {
            "name": "Beobachtete Inaktivitätsquote (Historisch)",
            "expression": "CALCULATE ( AVERAGE ( ChurnFeatures[InactiveNextMonth] ), ChurnFeatures[EligibleForTraining] = 1, REMOVEFILTERS ( ChurnPredictions ) )",
            "formatString": "0.00 %",
            "displayFolder": "01 Historischer Trend",
            "dataType": "double"
          },
          {
            "name": "Qualifizierte Aktive Kunden (Historisch)",
            "expression": "CALCULATE ( COUNTROWS ( ChurnFeatures ), ChurnFeatures[EligibleForTraining] = 1, REMOVEFILTERS ( ChurnPredictions ) )",
            "formatString": "#,0",
            "displayFolder": "01 Historischer Trend",
            "dataType": "int64"
          },
          {
            "name": "Kunden Transaktionen (Monat)",
            "expression": "SUM ( ChurnFeatures[TransactionCount] )",
            "formatString": "#,0",
            "displayFolder": "03 Kundenprofil 360°",
            "dataType": "int64"
          },
          {
            "name": "Kunden Transaktionsvolumen (COP)",
            "expression": "SUM ( ChurnFeatures[TotalAmount] )",
            "formatString": "\"COP\" #,0",
            "displayFolder": "03 Kundenprofil 360°",
            "dataType": "double"
          },
          {
            "name": "Benchmark Aktive Kunden Transaktionen",
            "expression": "CALCULATE ( AVERAGE ( ChurnFeatures[TransactionCount] ), ALL ( DimCustomer ), ChurnFeatures[TransactionCount] > 0 )",
            "formatString": "0.00",
            "displayFolder": "03 Kundenprofil 360°",
            "dataType": "double"
          },
          {
            "name": "Beobachtete Inaktivitätsquote (Verhalten)",
            "expression": "CALCULATE ( AVERAGE ( ChurnFeatures[InactiveNextMonth] ), ChurnFeatures[EligibleForTraining] = 1 )",
            "formatString": "0.0 %",
            "displayFolder": "04 Risikotreiber (XAI)",
            "dataType": "double"
          },
          {
            "name": "Geprüfte Roh-Transaktionen",
            "expression": "SUM ( ChurnFeatures[TransactionCount] )",
            "formatString": "#,0",
            "displayFolder": "06 Datenqualität & Governance",
            "dataType": "int64"
          },
          {
            "name": "Kundenmonate Gesamt",
            "expression": "COUNTROWS ( ChurnFeatures )",
            "formatString": "#,0",
            "displayFolder": "06 Datenqualität & Governance",
            "dataType": "int64"
          },
          {
