// Read-only full-row parity extract from existing PBIX; never publish with user records.
EVALUATE
SELECTCOLUMNS(
    ChurnFeatures,
    "customer_id", ChurnFeatures[customer_id],
    "Month", ChurnFeatures[Month],
    "TransactionCount", ChurnFeatures[TransactionCount],
    "TotalAmount", ChurnFeatures[TotalAmount],
    "TransferCount", ChurnFeatures[TransferCount],
    "PaymentCount", ChurnFeatures[PaymentCount],
    "WithdrawalCount", ChurnFeatures[WithdrawalCount],
    "DepositCount", ChurnFeatures[DepositCount],
    "TransferAmount", ChurnFeatures[TransferAmount],
    "PaymentAmount", ChurnFeatures[PaymentAmount],
    "WithdrawalAmount", ChurnFeatures[WithdrawalAmount],
    "DepositAmount", ChurnFeatures[DepositAmount],
    "FirstTransactionDate", ChurnFeatures[FirstTransactionDate],
    "LastTransactionDate", ChurnFeatures[LastTransactionDate],
    "ActiveDays", ChurnFeatures[ActiveDays],
    "WeekendTransactionCount", ChurnFeatures[WeekendTransactionCount],
    "TransactionsPerCalendarDay", ChurnFeatures[TransactionsPerCalendarDay],
    "WeekendTransactionRatio", ChurnFeatures[WeekendTransactionRatio],
    "ObservedTenureMonths", ChurnFeatures[ObservedTenureMonths],
    "PreferredTransactionType", ChurnFeatures[PreferredTransactionType],
    "PaymentShare", ChurnFeatures[PaymentShare],
    "TransferShare", ChurnFeatures[TransferShare],
    "WithdrawalShare", ChurnFeatures[WithdrawalShare],
    "DepositShare", ChurnFeatures[DepositShare],
    "InactiveMonth", ChurnFeatures[InactiveMonth],
    "PreviousTransactionCount", ChurnFeatures[PreviousTransactionCount],
    "PreviousTotalAmount", ChurnFeatures[PreviousTotalAmount],
    "TransactionCountChange", ChurnFeatures[TransactionCountChange],
    "TransactionCountChangePct", ChurnFeatures[TransactionCountChangePct],
    "TotalAmountChange", ChurnFeatures[TotalAmountChange],
    "TotalAmountChangePct", ChurnFeatures[TotalAmountChangePct],
    "ActivityDeclineFlag", ChurnFeatures[ActivityDeclineFlag],
    "ConsecutiveInactiveMonths", ChurnFeatures[ConsecutiveInactiveMonths],
    "DaysSinceLastTransaction", ChurnFeatures[DaysSinceLastTransaction],
    "TransactionCount_Recent3M", ChurnFeatures[TransactionCount_Recent3M],
    "TransactionCount_Previous3M", ChurnFeatures[TransactionCount_Previous3M],
    "TransactionCount_3M_ChangePct", ChurnFeatures[TransactionCount_3M_ChangePct],
    "TotalAmount_Recent3M", ChurnFeatures[TotalAmount_Recent3M],
    "TotalAmount_Previous3M", ChurnFeatures[TotalAmount_Previous3M],
    "TotalAmount_3M_ChangePct", ChurnFeatures[TotalAmount_3M_ChangePct],
    "TransactionDecline50Pct", ChurnFeatures[TransactionDecline50Pct],
    "SpendingDecline50Pct", ChurnFeatures[SpendingDecline50Pct],
    "InactiveNextMonth", ChurnFeatures[InactiveNextMonth],
    "ExtendedInactivityNext3Months", ChurnFeatures[ExtendedInactivityNext3Months],
    "Has6MonthHistory", ChurnFeatures[Has6MonthHistory],
    "EligibleForTraining", ChurnFeatures[EligibleForTraining]
)
